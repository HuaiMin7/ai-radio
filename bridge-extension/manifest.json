{
  "manifest_version": 3,
  "name": "Redio Bridge",
  "description": "Bridge QQ Music web login state to Redio.",
  "version": "0.1.5",
  "permissions": ["cookies", "tabs"],
  "host_permissions": [
    "https://qq.com/*",
    "https://*.qq.com/*",
    "https://y.qq.com/*",
    "https://halou.net.cn/*",
    "https://www.halou.net.cn/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://halou.net.cn/*",
        "https://www.halou.net.cn/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://y.qq.com/*", "https://*.y.qq.com/*"],
      "js": ["qq-page-content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.svg"
  }
}
